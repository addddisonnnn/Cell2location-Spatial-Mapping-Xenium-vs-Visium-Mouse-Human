# =============================================================================
# .gitignore
# Cell2Location Spatial Mapping Project
# =============================================================================

# ── Data directory — never commit raw data (~11GB) ───────────────────────────
data/

# ── Results directory — never commit large outputs ───────────────────────────
results/

# ── Singularity container ─────────────────────────────────────────────────────
*.sif

# ── Python artifacts ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
.ipynb_checkpoints/
*.egg-info/
dist/
build/
.eggs/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Large biological data file formats ───────────────────────────────────────
*.h5
*.h5ad
*.h5ad.gz
*.loom
*.zarr
*.zarr.zip
*.parquet
*.tsv.gz
*.csv.gz
*.fastq.gz
*.bam
*.bai
*.vcf
*.bcf
*.bed
*.narrowPeak
*.bigwig
*.bw

# ── Images generated by pipeline ─────────────────────────────────────────────
# Uncomment if you do NOT want to track output figures in git:
# *.png
# *.pdf
# *.svg

# ── OS and editor artifacts ───────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ── Environment and secrets ───────────────────────────────────────────────────
.env
.env.local
*.key
*.pem

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
slurm-*.out
slurm-*.err
nohup.out

# ── What IS tracked ───────────────────────────────────────────────────────────
# scripts/          ← all Python analysis scripts
# shell_scripts/    ← all download shell scripts
# README.md
# project_environment.yml
# .gitignore